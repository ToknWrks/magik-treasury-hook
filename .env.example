# Copy to .env and fill in. Never commit the real .env.
# Testnet-only: PRIVATE_KEY should be a throwaway Base Sepolia key.
PRIVATE_KEY=0xyour_testnet_deployer_private_key
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=your_basescan_api_key

# Filled in from script output as you go (see README "Deploy order").
TREASURY_TOKEN_ADDRESS=
VAULT_ADDRESS=
TREASURY_HOOK_ADDRESS=
SELL_AMOUNT_WEI=

# Optional, used by DeployTreasuryHook.s.sol. Omit to leave standing-bid price support disabled.
PRICE_SUPPORT_BPS=
BID_TICKS_BELOW_SPOT=
BID_WIDTH_TICKS=
